#property copyright "MJ_Updated"
#property link      ""
#property version   "1"

#include <Trade\Trade.mqh>

//--- Default Input Parameters (These will load into the UI first) ---
input double   InpRiskPercent = 0.25;      // Default Risk Percentage (%)
input int      InpStopLossPips = 10;       // Default Stop Loss in Pips
input double   InpRR_Ratio = 3.0;          // Default Reward to Risk Ratio (e.g., 3.0 for 1:3)
input ulong    InpMagicNumber = 123456;    // Magic Number
input ulong    InpSlippage = 3;            // Slippage (in points)

CTrade trade;

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
  {
   trade.SetExpertMagicNumber(InpMagicNumber);
   trade.SetDeviationInPoints(InpSlippage);

   // 1. Create Background Panel
   CreatePanel("bg_Panel", 30, 30, 220, 200, clrBlack, clrDarkGray);

   // 2. Create Labels and Edit Boxes for Inputs on Chart
   CreateLabel("lbl_Risk", "Risk (%):", 40, 50);
   CreateEdit("edit_Risk", DoubleToString(InpRiskPercent, 2), 150, 45, 80, 20);

   CreateLabel("lbl_SL", "SL (Pips):", 40, 80);
   CreateEdit("edit_SL", IntegerToString(InpStopLossPips), 150, 75, 80, 20);

   CreateLabel("lbl_RR", "R:R Ratio:", 40, 110);
   CreateEdit("edit_RR", DoubleToString(InpRR_Ratio, 1), 150, 105, 80, 20);

   // 3. Create GUI Buttons on the Chart
   CreateButton("btn_Buy", "BUY", 40, 150, 90, 40, clrWhite, clrDodgerBlue);
   CreateButton("btn_Sell", "SELL", 140, 150, 90, 40, clrWhite, clrCrimson);

   ChartRedraw();
   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
//| Expert deinitialization function                                 |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   // Clean up the chart when removing the EA
   ObjectDelete(0, "bg_Panel");
   ObjectDelete(0, "lbl_Risk");
   ObjectDelete(0, "edit_Risk");
   ObjectDelete(0, "lbl_SL");
   ObjectDelete(0, "edit_SL");
   ObjectDelete(0, "lbl_RR");
   ObjectDelete(0, "edit_RR");
   ObjectDelete(0, "btn_Buy");
   ObjectDelete(0, "btn_Sell");
   ChartRedraw();
  }

//+------------------------------------------------------------------+
//| ChartEvent function (To detect button clicks)                    |
//+------------------------------------------------------------------+
void OnChartEvent(const int id,
                  const long &lparam,
                  const double &dparam,
                  const string &sparam)
  {
   if(id == CHARTEVENT_OBJECT_CLICK)
     {
      if(sparam == "btn_Buy")
        {
         ExecuteTrade(ORDER_TYPE_BUY);
         ObjectSetInteger(0,"btn_Buy",OBJPROP_STATE,false); // Unpress button
        }
      else if(sparam == "btn_Sell")
        {
         ExecuteTrade(ORDER_TYPE_SELL);
         ObjectSetInteger(0,"btn_Sell",OBJPROP_STATE,false); // Unpress button
        }
     }
  }

//+------------------------------------------------------------------+
//| Custom Function: Create Background Panel                         |
//+------------------------------------------------------------------+
void CreatePanel(string name, int x, int y, int width, int height, color bgColor, color borderColor)
  {
   ObjectCreate(0, name, OBJ_RECTANGLE_LABEL, 0, 0, 0);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, name, OBJPROP_XSIZE, width);
   ObjectSetInteger(0, name, OBJPROP_YSIZE, height);
   ObjectSetInteger(0, name, OBJPROP_BGCOLOR, bgColor);
   ObjectSetInteger(0, name, OBJPROP_COLOR, borderColor);
   ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, name, OBJPROP_BACK, true);
  }

//+------------------------------------------------------------------+
//| Custom Function: Create Text Labels                              |
//+------------------------------------------------------------------+
void CreateLabel(string name, string text, int x, int y)
  {
   ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetString(0, name, OBJPROP_TEXT, text);
   ObjectSetInteger(0, name, OBJPROP_COLOR, clrWhite);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, 10);
   ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
  }

//+------------------------------------------------------------------+
//| Custom Function: Create Edit Boxes (Input Fields)                |
//+------------------------------------------------------------------+
void CreateEdit(string name, string text, int x, int y, int width, int height)
  {
   ObjectCreate(0, name, OBJ_EDIT, 0, 0, 0);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, name, OBJPROP_XSIZE, width);
   ObjectSetInteger(0, name, OBJPROP_YSIZE, height);
   ObjectSetString(0, name, OBJPROP_TEXT, text);
   ObjectSetInteger(0, name, OBJPROP_BGCOLOR, clrWhite);
   ObjectSetInteger(0, name, OBJPROP_COLOR, clrBlack);
   ObjectSetInteger(0, name, OBJPROP_ALIGN, ALIGN_CENTER);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, 10);
   ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
  }

//+------------------------------------------------------------------+
//| Custom Function: Create GUI Buttons                              |
//+------------------------------------------------------------------+
void CreateButton(string name, string text, int x, int y, int width, int height, color textColor, color bgColor)
  {
   ObjectCreate(0, name, OBJ_BUTTON, 0, 0, 0);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, name, OBJPROP_XSIZE, width);
   ObjectSetInteger(0, name, OBJPROP_YSIZE, height);
   ObjectSetString(0, name, OBJPROP_TEXT, text);
   ObjectSetInteger(0, name, OBJPROP_COLOR, textColor);
   ObjectSetInteger(0, name, OBJPROP_BGCOLOR, bgColor);
   ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, 12);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
  }

//+------------------------------------------------------------------+
//| Custom Function: Calculate Lot Size and Execute Trade            |
//+------------------------------------------------------------------+
void ExecuteTrade(ENUM_ORDER_TYPE type)
  {
   // --- Read Values from Chart UI ---
   double uiRiskPercent = StringToDouble(ObjectGetString(0, "edit_Risk", OBJPROP_TEXT));
   int uiStopLossPips   = (int)StringToInteger(ObjectGetString(0, "edit_SL", OBJPROP_TEXT));
   double uiRR_Ratio    = StringToDouble(ObjectGetString(0, "edit_RR", OBJPROP_TEXT));

   // Validate inputs
   if(uiRiskPercent <= 0 || uiStopLossPips <= 0 || uiRR_Ratio <= 0)
     {
      Print("Error: Invalid input values on the chart. Please check Risk, SL, and RR.");
      return;
     }

   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double riskAmount = balance * (uiRiskPercent / 100.0);

   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);

   if(tickSize == 0 || tickValue == 0) 
     {
      Print("Error getting tick value. Trade aborted.");
      return;
     }

   // Handle 3 and 5 digit brokers (Pips vs Points)
   int digit_mult = (_Digits == 3 || _Digits == 5) ? 10 : 1;
   
   double sl_points = uiStopLossPips * digit_mult * point;
   double tp_points = (uiStopLossPips * uiRR_Ratio) * digit_mult * point; // TP calculated using RR Ratio

   // Calculate Loss per 1 Standard Lot
   double lossPerLot = (sl_points / tickSize) * tickValue;

   // Calculate required Lot Size
   double rawVolume = riskAmount / lossPerLot;

   // Normalize Lot Size according to Broker rules
   double minVol = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxVol = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double stepVol = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   double lotSize = MathFloor(rawVolume / stepVol) * stepVol;
   if(lotSize < minVol) lotSize = minVol;
   if(lotSize > maxVol) lotSize = maxVol;

   // Get current market price
   double price = (type == ORDER_TYPE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
   
   // Calculate Stop Loss and Take Profit prices
   double sl = (type == ORDER_TYPE_BUY) ? price - sl_points : price + sl_points;
   double tp = (type == ORDER_TYPE_BUY) ? price + tp_points : price - tp_points;

   // Send Trade Request
   if(type == ORDER_TYPE_BUY)
     {
      if(trade.Buy(lotSize, _Symbol, price, sl, tp, "AI_RiskManager"))
         Print("BUY Order Executed. Lot: ", lotSize, " | SL: ", uiStopLossPips, " pips | TP: ", (uiStopLossPips * uiRR_Ratio), " pips");
     }
   else
     {
      if(trade.Sell(lotSize, _Symbol, price, sl, tp, "AI_RiskManager"))
         Print("SELL Order Executed. Lot: ", lotSize, " | SL: ", uiStopLossPips, " pips | TP: ", (uiStopLossPips * uiRR_Ratio), " pips");
     }
  }
